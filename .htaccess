<IfModule mod_rewrite.c>
    RewriteEngine On
    
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # Routing API Auth OTP
    RewriteRule ^api/auth/send-otp/?$ api/auth/send-otp.php [QSA,L]
    RewriteRule ^api/auth/verify-otp/?$ api/auth/verify-otp.php [QSA,L]

    # Routing API OAuth Google
    RewriteRule ^api/auth/google/redirect/?$ api/auth/google-redirect.php [QSA,L]
    RewriteRule ^api/auth/google/callback/?$ api/auth/google-callback.php [QSA,L]

    # Routing API OAuth GitHub
    RewriteRule ^api/auth/github/redirect/?$ api/auth/github-redirect.php [QSA,L]
    RewriteRule ^api/auth/github/callback/?$ api/auth/github-callback.php [QSA,L]

    # Routing Halaman Course dengan Topic (Clean URL)
    # Format: /course/slug-course/topic/37  ATAU  /course/slug-course/37
    RewriteRule ^course/([a-zA-Z0-9-]+)/topic/([0-9]+)/?$ course.php?slug=$1&topic=$2 [QSA,L]
    RewriteRule ^course/([a-zA-Z0-9-]+)/([0-9]+)/?$ course.php?slug=$1&topic=$2 [QSA,L]

    # Routing Halaman Course Standard (tanpa topic)
    RewriteRule ^course/([0-9]+)/?$ course.php?id=$1 [QSA,L]
    RewriteRule ^course/([a-zA-Z0-9-]+)/?$ course.php?slug=$1 [QSA,L]
</IfModule>