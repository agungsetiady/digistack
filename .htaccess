RewriteEngine On

# 1. Abaikan file atau folder fisik nyata secara langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Routing khusus clean URL login & logout
RewriteRule ^course/?$ course.php [L,QSA]

# 3. Sembunyikan ekstensi .php untuk file lainnya
RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]