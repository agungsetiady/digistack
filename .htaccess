<IfModule mod_rewrite.c>
    RewriteEngine On

    # Kosongkan atau abaikan RewriteBase agar relatif terhadap folder .htaccess berada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Routing API Auth OTP
    RewriteRule ^api/auth/send-otp/?$ api/auth/send-otp.php [QSA,L]
    RewriteRule ^api/auth/verify-otp/?$ api/auth/verify-otp.php [QSA,L]

    # Routing API OAuth Google
    RewriteRule ^api/auth/google/redirect/?$ api/auth/google-redirect.php [QSA,L]
    RewriteRule ^api/auth/google/callback/?$ api/auth/google-callback.php [QSA,L]

    # Routing Halaman Course
    RewriteRule ^course/([0-9]+)/?$ course.php?id=$1 [QSA,L]
    RewriteRule ^course/([a-zA-Z0-9-]+)/?$ course.php?slug=$1 [QSA,L]
</IfModule>